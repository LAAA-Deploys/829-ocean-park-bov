{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laaa.com/contracts/bov/deal-1.1.0.schema.json",
  "title": "BOV deal identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "deal_id",
    "slug",
    "seller_side",
    "workspace_root",
    "primary_address",
    "addresses",
    "address_provenance",
    "apns",
    "apn_provenance",
    "unit_count",
    "year_built",
    "building_sf",
    "lot",
    "jurisdiction",
    "rooftop_pin",
    "portfolio_ref",
    "public_names",
    "workspace_layout",
    "presentation",
    "regulatory_conclusions",
    "unit_sf"
  ],
  "properties": {
    "schema_version": {
      "description": "1.1.0 resolves team headshots from the canonical registry instead of an authored path. 1.0.0 is still accepted and still builds: the authored headshot field is ignored, so no workspace needs migrating.",
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "document_type": {
      "const": "bov"
    },
    "deal_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "seller_side": {
      "type": "boolean"
    },
    "workspace_root": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:|/|\\\\)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
    },
    "primary_address": {
      "type": "string",
      "minLength": 3
    },
    "addresses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "address_provenance": {
      "$ref": "#/$defs/provenance"
    },
    "apns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "apn_provenance": {
      "$ref": "#/$defs/provenance"
    },
    "unit_count": {
      "$ref": "#/$defs/provenancedInteger"
    },
    "year_built": {
      "$ref": "#/$defs/provenancedInteger"
    },
    "renovated_year": {
      "$ref": "#/$defs/provenancedInteger"
    },
    "building_sf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "provenance",
        "sf_basis"
      ],
      "properties": {
        "value": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "sf_basis": {
          "enum": [
            "verified_gross",
            "verified_rentable",
            "labelled_estimate",
            "unknown"
          ]
        }
      }
    },
    "lot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "square_feet",
        "provenance"
      ],
      "properties": {
        "square_feet": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "acres": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 2
    },
    "rooftop_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "place_id",
        "latitude",
        "longitude",
        "review_state",
        "reviewed_by",
        "reviewed_at"
      ],
      "properties": {
        "place_id": {
          "type": "string",
          "minLength": 5
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "review_state": {
          "const": "approved_rooftop"
        },
        "reviewed_by": {
          "type": "string",
          "minLength": 2
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "portfolio_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "public_names": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "workspace_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "site_repo",
        "model_workbook",
        "source_documents",
        "media_root"
      ],
      "properties": {
        "site_repo": {
          "$ref": "#/$defs/relativePath"
        },
        "model_workbook": {
          "$ref": "#/$defs/relativePath"
        },
        "source_documents": {
          "$ref": "#/$defs/relativePath"
        },
        "media_root": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "client",
        "title",
        "subtitle",
        "month_year",
        "short_name",
        "city",
        "submarket",
        "parking",
        "team"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "minLength": 3
        },
        "client": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string",
          "minLength": 1
        },
        "month_year": {
          "type": "string",
          "minLength": 3
        },
        "cover_label": {
          "type": "string"
        },
        "short_name": {
          "type": "string",
          "minLength": 1
        },
        "city": {
          "type": "string",
          "minLength": 2
        },
        "submarket": {
          "type": "string",
          "minLength": 2
        },
        "parking": {
          "type": "string"
        },
        "track_record_submarkets": {
          "description": "OPTIONAL. Adjacent submarkets to count TOGETHER as this property's local track record, with the label to print. A single submarket is the default and needs nothing here; a property whose market is genuinely read as a cluster of adjacent submarkets declares that cluster explicitly rather than the engine guessing which names belong together. 'submarkets' must be Airtable Submarket values matched exactly, and 'label' is the client-facing phrase after the count, e.g. 'in the South Valley'. Every named submarket is aggregated, so the published count is auditable against the same closed-deal source as every other track-record figure.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "submarkets",
            "label"
          ],
          "properties": {
            "submarkets": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string",
                "minLength": 2
              }
            },
            "label": {
              "type": "string",
              "minLength": 2
            }
          }
        },
        "team": {
          "$ref": "#/$defs/team"
        },
        "maps": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "subject": {
              "type": [
                "string",
                "null"
              ]
            },
            "sale": {
              "type": [
                "string",
                "null"
              ]
            },
            "rent": {
              "type": [
                "string",
                "null"
              ]
            },
            "active": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "no_photo_cover": {
          "type": [
            "string",
            "null"
          ]
        },
        "hero_tall": {
          "type": [
            "string",
            "null"
          ]
        },
        "show_active_listings": {
          "type": "boolean"
        },
        "show_buyout_model": {
          "type": "boolean",
          "description": "Opt in to the Buyout Scenarios section. Off for every deal that does not set it, exactly like show_active_listings. Requires buyout_model."
        },
        "buyout_model": {
          "type": "object",
          "additionalProperties": false,
          "description": "Inputs for the interactive Buyout Scenarios section. Every figure is an author-set assumption the reader can move; the section computes and recommends nothing on its own.",
          "required": [
            "units_turned",
            "intro",
            "as_is_default",
            "as_is_min",
            "as_is_max",
            "vacant_default",
            "vacant_min",
            "vacant_max",
            "reno_default",
            "reno_min",
            "reno_max",
            "margin_default",
            "soft_costs",
            "benchmarks",
            "benchmark_note",
            "method_note"
          ],
          "properties": {
            "units_turned": {
              "type": "integer",
              "minimum": 1,
              "description": "Units assumed delivered vacant and renovated."
            },
            "intro": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              },
              "description": "Paragraphs above the model."
            },
            "as_is_default": {
              "type": "integer",
              "minimum": 0,
              "description": "Opinion point of value, as is.",
              "multipleOf": 5000
            },
            "as_is_min": {
              "type": "integer",
              "minimum": 0,
              "description": "Low end of the as-is slider.",
              "multipleOf": 5000
            },
            "as_is_max": {
              "type": "integer",
              "minimum": 0,
              "description": "High end of the as-is slider.",
              "multipleOf": 5000
            },
            "vacant_default": {
              "type": "integer",
              "minimum": 0,
              "description": "Opinion point of value, units delivered vacant.",
              "multipleOf": 5000
            },
            "vacant_min": {
              "type": "integer",
              "minimum": 0,
              "description": "Low end of the vacant slider.",
              "multipleOf": 5000
            },
            "vacant_max": {
              "type": "integer",
              "minimum": 0,
              "description": "High end of the vacant slider.",
              "multipleOf": 5000
            },
            "reno_default": {
              "type": "integer",
              "minimum": 0,
              "description": "Renovation per unit, point assumption.",
              "multipleOf": 500
            },
            "reno_min": {
              "type": "integer",
              "minimum": 0,
              "description": "Low end of the renovation slider.",
              "multipleOf": 500
            },
            "reno_max": {
              "type": "integer",
              "minimum": 0,
              "description": "High end of the renovation slider.",
              "multipleOf": 500
            },
            "margin_default": {
              "type": "integer",
              "minimum": 0,
              "maximum": 40,
              "description": "Required profit margin percent, 0-40.",
              "multipleOf": 5
            },
            "soft_costs": {
              "type": "array",
              "minItems": 1,
              "description": "Transaction costs held constant. The section sums them; never author the total.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "amount"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "amount": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Cost per unit turned."
                  }
                }
              }
            },
            "benchmarks": {
              "type": "array",
              "minItems": 1,
              "description": "Published reference amounts the result is measured against, e.g. LAHD relocation. Never a figure the agent invented.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "amount"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "amount": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Published benchmark amount."
                  }
                }
              }
            },
            "benchmark_note": {
              "type": "string",
              "minLength": 1,
              "description": "Source and effective date of the benchmarks."
            },
            "method_note": {
              "type": "string",
              "minLength": 1,
              "description": "What the arithmetic does and does not assume."
            }
          }
        },
        "track_record_representative": {
          "description": "OPTIONAL. How the three named 'Representative Local Closings' are chosen from the local scope. Default 'balanced' is the equal-weight distance/unit-similarity/recency rank. 'recent' names the most recent closings in the scope (year, then distance, then address), for a seller who asked to see the latest LAAA closings in their city (Aida, 829 Ocean Park, 2026-09-02). Either way the rows come from the same scope as the local count and the map.",
          "type": "string",
          "enum": [
            "balanced",
            "recent"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "show_buyout_model": {
                "const": true
              }
            },
            "required": [
              "show_buyout_model"
            ]
          },
          "then": {
            "required": [
              "buyout_model"
            ]
          }
        }
      ]
    },
    "regulatory_conclusions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rent_control",
        "zoning",
        "development"
      ],
      "properties": {
        "rent_control": {
          "$ref": "#/$defs/conclusion"
        },
        "zoning": {
          "$ref": "#/$defs/conclusion"
        },
        "development": {
          "$ref": "#/$defs/conclusion"
        }
      }
    },
    "unit_sf": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit_type",
          "value",
          "sf_basis",
          "approval_exception_id"
        ],
        "properties": {
          "unit_type": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "sf_basis": {
            "enum": [
              "verified",
              "labelled_estimate",
              "omitted"
            ]
          },
          "approval_exception_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "sf_basis": {
                  "const": "omitted"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:|/|\\\\)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "source_ids"
      ],
      "properties": {
        "authority": {
          "type": "string",
          "minLength": 2
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "conflict_exception_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "provenancedInteger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "provenance"
      ],
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 1
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conclusion",
        "support_refs",
        "as_of_date",
        "approved_exception_id"
      ],
      "properties": {
        "conclusion": {
          "type": "string",
          "minLength": 1
        },
        "support_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "as_of_date": {
          "type": "string",
          "format": "date"
        },
        "approved_exception_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leads",
        "grid"
      ],
      "properties": {
        "leads": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/teamMember"
          }
        },
        "grid": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/teamMember"
          }
        }
      }
    },
    "teamMember": {
      "type": "object",
      "description": "A member's headshot is not authored: it is resolved from branding/headshots/canonical-headshots.json by the member's name at build time.",
      "additionalProperties": false,
      "required": [
        "name",
        "title",
        "phone",
        "tel",
        "email",
        "license",
        "bio"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "tel": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "headshot": {
          "type": "string",
          "description": "LEGACY and IGNORED. Pre-1.1.0 spines authored a headshot path here. The build resolves each member's approved headshot from branding/headshots/canonical-headshots.json by name and overwrites this value, so an old spine still builds correctly and needs no migration. Never author it in a new spine."
        },
        "bio": {
          "type": "string"
        },
        "role_kicker": {
          "enum": [
            "Principal"
          ],
          "description": "DERIVED, not authored. A LAAA principal carries 'Principal'; everyone else carries no kicker unless a business role is added to APPROVED_ROLE_KICKERS in blocks.py and checks/identity.py in a reviewed change. This was any nonempty string until 2026-08-20, which is how the filler label 'Assignment Team' shipped on the seller-facing 524 Lincoln page."
        }
      }
    }
  }
}
